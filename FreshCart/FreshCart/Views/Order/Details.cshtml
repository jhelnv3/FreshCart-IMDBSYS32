@model FreshCart.Web.Models.Entities.Order

@{
    ViewData["Title"] = $"Order #{Model.OrderNumber}";
}

<h2 class="mb-4">📄 Order Details</h2>

<div class="row">
    <div class="col-md-8">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-success text-white">
                <h5 class="mb-0">Order #@Model.OrderNumber</h5>
            </div>
            <div class="card-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Order Date:</strong> @Model.OrderDate.ToString("MMMM dd, yyyy HH:mm")
                    </div>
                    <div class="col-md-6">
                        <strong>Status:</strong>
                        @{
                            var statusClass = Model.Status switch
                            {
                                "Pending" => "bg-warning",
                                "Packing" => "bg-info",
                                "ToDeliver" => "bg-primary",
                                "ToReceive" => "bg-primary",
                                "Delivered" => "bg-success",
                                "Received" => "bg-secondary",
                                _ => "bg-light text-dark"
                            };
                        }
                        <span class="badge @statusClass">@Model.Status</span>
                    </div>
                </div>

                @if (Model.ReceivedDate.HasValue)
                {
                    <div class="mb-3">
                        <strong>Received Date:</strong> @Model.ReceivedDate.Value.ToString("MMMM dd, yyyy HH:mm")
                    </div>
                }

                <div class="mb-3">
                    <strong>Shipping Address:</strong><br />
                    <p class="border p-2 rounded bg-light">@Model.ShippingAddress</p>
                </div>

                <h6 class="mb-3">Order Items:</h6>
                <div class="table-responsive">
                    <table class="table table-sm table-bordered">
                        <thead class="table-light">
                            <tr>
                                <th>Product</th>
                                <th>Price</th>
                                <th>Quantity</th>
                                <th>Subtotal</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.OrderDetails != null)
                            {
                                @foreach (var detail in Model.OrderDetails)
                                {
                                    <tr>
                                        <td>@detail.Product?.Name</td>
                                        <td>₱@detail.UnitPrice.ToString("N2")</td>
                                        <td>@detail.Quantity</td>
                                        <td>₱@((detail.UnitPrice * detail.Quantity).ToString("N2"))</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Order Status Timeline -->
        <div class="card shadow-sm">
            <div class="card-body">
                <h5 class="card-title">Order Progress</h5>
                @{
                    var statuses = new[] { "Pending", "Packing", "ToDeliver", "ToReceive", "Delivered", "Received" };
                    var currentIndex = Array.IndexOf(statuses, Model.Status);
                    if (currentIndex < 0) currentIndex = 0;
                }
                <div class="progress-steps">
                    @for (int i = 0; i < statuses.Length; i++)
                    {
                        var isCompleted = i <= currentIndex;
                        var isCurrent = i == currentIndex;
                        <div class="d-flex align-items-center mb-2">
                            <div class="step-circle @(isCompleted ? "bg-success" : "bg-light") @(isCurrent ? "fw-bold" : "")"
                                 style="width: 30px; height: 30px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center; color: @(isCompleted ? "white" : "#6c757d"); border: 2px solid @(isCompleted ? "#198754" : "#dee2e6");">
                                @(isCompleted ? "✓" : (i + 1).ToString())
                            </div>
                            <span class="ms-2 @(isCurrent ? "fw-bold" : "") @(isCompleted ? "text-success" : "text-muted")">
                                @statuses[i]
                            </span>
                        </div>
                        @if (i < statuses.Length - 1)
                        {
                            <div class="ms-2" style="width: 2px; height: 20px; background-color: @(i < currentIndex ? "#198754" : "#dee2e6"); margin-left: 14px;"></div>
                        }
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm mb-3">
            <div class="card-body checkout-summary">
                <h5 class="card-title">Order Summary</h5>
                <hr />
                <div class="d-flex justify-content-between mb-2">
                    <span>Subtotal</span>
                    <span>₱@((Model.TotalAmount - 50).ToString("N2"))</span>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span>Delivery Fee</span>
                    <span>₱50.00</span>
                </div>
                <hr />
                <div class="d-flex justify-content-between mb-2">
                    <strong>Total</strong>
                    <strong class="text-success">₱@Model.TotalAmount.ToString("N2")</strong>
                </div>
                <hr />
                <div class="mb-2">
                    <strong>Payment Method:</strong> @Model.PaymentMethod
                </div>
            </div>
        </div>

        @if (Model.Status == "Delivered" && Context.Session.GetString("UserId") == Model.UserId.ToString())
        {
            <form method="post" action="/Order/ConfirmReceipt">
                <input type="hidden" name="orderId" value="@Model.OrderId" />
                <button type="submit" class="btn btn-success w-100">
                    ✅ Confirm Receipt
                </button>
            </form>
        }

        <div class="mt-3">
            <a href="/Order/Tracking" class="btn btn-outline-secondary w-100">
                Back to Orders
            </a>
        </div>
    </div>
</div>