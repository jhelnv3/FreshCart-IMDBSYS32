@model List<FreshCart.Web.Models.Entities.Order>

@{
    ViewData["Title"] = "Order History";
}

<h2 class="mb-4">📜 Order History</h2>

@if (Model != null && Model.Any())
{
    <div class="row">
        @foreach (var order in Model)
        {
            <div class="col-md-6 mb-3">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <h6 class="card-title">#@order.OrderNumber</h6>
                                <p class="mb-1">
                                    <small class="text-muted">@order.OrderDate.ToString("MMM dd, yyyy")</small>
                                </p>
                            </div>
                            @{
                                var statusClass = order.Status switch
                                {
                                    "Pending" => "bg-warning",
                                    "Packing" => "bg-info",
                                    "ToDeliver" => "bg-primary",
                                    "ToReceive" => "bg-primary",
                                    "Delivered" => "bg-success",
                                    "Received" => "bg-secondary",
                                    _ => "bg-light text-dark"
                                };
                            }
                            <span class="badge @statusClass">@order.Status</span>
                        </div>
                        <hr />
                        <div class="d-flex justify-content-between">
                            <span>₱@order.TotalAmount.ToString("N2")</span>
                            <a href="/Order/Details/@order.OrderId" class="btn btn-sm btn-outline-success">View</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5">
        <h3>No order history</h3>
        <a href="/Product" class="btn btn-success">Start Shopping</a>
    </div>
}