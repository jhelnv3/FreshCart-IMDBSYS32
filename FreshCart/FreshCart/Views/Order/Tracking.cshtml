@model List<FreshCart.Web.Models.Entities.Order>

@{
    ViewData["Title"] = "Order Tracking";
}

<h2 class="mb-4">📋 Order Tracking</h2>

@if (Model != null && Model.Any())
{
    <div class="table-responsive">
        <table class="table table-hover shadow-sm">
            <thead>
                <tr>
                    <th>Order #</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th>Payment</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                        <td><strong>@order.OrderNumber</strong></td>
                        <td>@order.OrderDate.ToString("MMM dd, yyyy HH:mm")</td>
                        <td>₱@order.TotalAmount.ToString("N2")</td>
                        <td>@order.PaymentMethod</td>
                        <td>
                            @{
                                var statusClass = order.Status switch
                                {
                                    "Pending" => "bg-warning",
                                    "Packing" => "bg-info",
                                    "ToDeliver" => "bg-primary",
                                    "ToReceive" => "bg-primary",
                                    "Delivered" => "bg-success",
                                    "Received" => "bg-secondary",
                                    _ => "bg-light text-dark"
                                };
                            }
                            <span class="badge @statusClass status-badge">@order.Status</span>
                        </td>
                        <td>
                            <a href="/Order/Details/@order.OrderId" class="btn btn-sm btn-outline-success">
                                View Details
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="text-center py-5">
        <h3>No orders yet</h3>
        <p>Start shopping to see your orders here.</p>
        <a href="/Product" class="btn btn-success">Shop Now</a>
    </div>
}