@model List<FreshCart.Web.Models.Entities.Order>

@{
    ViewData["Title"] = "Manage Orders";
    var currentStatus = ViewBag.CurrentStatus as string ?? "All";
    var search = ViewBag.Search as string;
}

<div class="row">
    <div class="col-md-3">
        @await Html.PartialAsync("_AdminSidebar")
    </div>
    <div class="col-md-9">
        <h2 class="mb-4">📋 Orders</h2>

        <!-- Search Bar -->
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <form method="get" action="/Admin/Orders" class="row g-3">
                    <input type="hidden" name="status" value="@currentStatus" />
                    <div class="col-md-10">
                        <input type="text" name="search" class="form-control"
                               placeholder="Search by order number or customer name..."
                               value="@search" />
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-success w-100">Search</button>
                    </div>
                </form>
            </div>
        </div>

        <!-- Status Filters -->
        <div class="card shadow-sm mb-3">
            <div class="card-body">
                <div class="d-flex gap-2 flex-wrap">
                    @{
                        var statuses = new[] { "All", "Pending", "Packing", "ToDeliver", "ToReceive", "Delivered", "Received" };
                    }
                    @foreach (var status in statuses)
                    {
                        <a href="/Admin/Orders?status=@status&search=@search"
                           class="btn btn-sm @(currentStatus == status ? "btn-success" : "btn-outline-success")">
                            @status
                        </a>
                    }
                </div>
            </div>
        </div>

        <!-- Orders Table -->
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>Order #</th>
                                <th>Customer</th>
                                <th>Date</th>
                                <th>Total</th>
                                <th>Payment</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var order in Model)
                                {
                                    <tr>
                                        <td><strong>@order.OrderNumber</strong></td>
                                        <td>@order.User?.FullName</td>
                                        <td>@order.OrderDate.ToString("MMM dd, yyyy")</td>
                                        <td>₱@order.TotalAmount.ToString("N2")</td>
                                        <td>@order.PaymentMethod</td>
                                        <td>
                                            @{
                                                var statusClass = order.Status switch
                                                {
                                                    "Pending" => "bg-warning",
                                                    "Packing" => "bg-info",
                                                    "ToDeliver" => "bg-primary",
                                                    "ToReceive" => "bg-primary",
                                                    "Delivered" => "bg-success",
                                                    "Received" => "bg-secondary",
                                                    _ => "bg-light text-dark"
                                                };
                                            }
                                            <span class="badge @statusClass">@order.Status</span>
                                        </td>
                                        <td>
                                            <a href="/Admin/OrderDetails/@order.OrderId"
                                               class="btn btn-sm btn-outline-success">Manage</a>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="7" class="text-center">No orders found</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>