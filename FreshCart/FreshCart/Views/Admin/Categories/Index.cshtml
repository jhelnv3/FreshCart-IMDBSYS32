@model List<FreshCart.Web.Models.Entities.Category>

@{
    ViewData["Title"] = "Manage Categories";
}

<div class="row">
    <div class="col-md-3">
        @await Html.PartialAsync("_AdminSidebar")
    </div>
    <div class="col-md-9">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h2>🏷️ Categories</h2>
            <a href="/Admin/CreateCategory" class="btn btn-success">+ Add Category</a>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model != null && Model.Any())
                            {
                                @foreach (var category in Model)
                                {
                                    <tr>
                                        <td>@category.CategoryId</td>
                                        <td>@category.Name</td>
                                        <td>@category.Description</td>
                                        <td>
                                            <a href="/Admin/EditCategory/@category.CategoryId"
                                               class="btn btn-sm btn-warning">Edit</a>
                                            <form method="post" action="/Admin/DeleteCategory"
                                                  style="display:inline;"
                                                  onsubmit="return confirm('Are you sure? This cannot be undone if category has no products.');">
                                                <input type="hidden" name="id" value="@category.CategoryId" />
                                                <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center">No categories found</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>