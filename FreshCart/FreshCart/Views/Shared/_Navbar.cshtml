@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var session = HttpContextAccessor.HttpContext?.Session;
    var isAuthenticated = session != null && !string.IsNullOrEmpty(session.GetString("UserId"));
    var username = isAuthenticated ? session.GetString("Username") : "";
    var role = isAuthenticated ? session.GetString("Role") : "";
    var isAdminOrStaff = role == "Admin" || role == "Staff";
}

<nav class="navbar navbar-expand-lg navbar-dark bg-success">
    <div class="container">
        <a class="navbar-brand" href="/">
            <span style="font-size: 1.5rem;">🛒</span> FreshCart
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="navbarNav">
            <ul class="navbar-nav me-auto">
                @if (isAuthenticated)
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Product" ? "active" : "")"
                           href="/Product">
                            <i class="bi bi-shop"></i> Products
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Cart" ? "active" : "")"
                           href="/Cart">
                            <i class="bi bi-cart"></i> Cart
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Order" ? "active" : "")"
                           href="/Order/Tracking">
                            <i class="bi bi-box"></i> Orders
                        </a>
                    </li>
                    @if (isAdminOrStaff)
                    {
                        <li class="nav-item">
                            <a class="nav-link @(ViewContext.RouteData.Values["Controller"]?.ToString() == "Admin" ? "active" : "")"
                               href="/Admin/Dashboard">
                                <i class="bi bi-speedometer2"></i> @(role == "Admin" ? "Admin" : "Staff")
                            </a>
                        </li>
                    }
                }
            </ul>
            <ul class="navbar-nav">
                @if (isAuthenticated)
                {
                    <li class="nav-item">
                        <span class="nav-link text-light">
                            <i class="bi bi-person"></i> @username
                            <span class="badge bg-light text-success ms-1">@role</span>
                        </span>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" href="/Account/Logout">
                            <i class="bi bi-box-arrow-right"></i> Logout
                        </a>
                    </li>
                }
                else
                {
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Login" ? "active" : "")"
                           href="/Account/Login">
                            <i class="bi bi-box-arrow-in-right"></i> Login
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link @(ViewContext.RouteData.Values["Action"]?.ToString() == "Register" ? "active" : "")"
                           href="/Account/Register">
                            <i class="bi bi-person-plus"></i> Register
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>
</nav>