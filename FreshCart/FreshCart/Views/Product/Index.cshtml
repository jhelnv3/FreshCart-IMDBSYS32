@model List<FreshCart.Web.Models.Entities.Product>
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    ViewData["Title"] = "Products";
    var categories = ViewBag.Categories as SelectList;
    var search = ViewBag.Search as string;
    var categoryId = ViewBag.CategoryId as int?;
    var currentPage = ViewBag.CurrentPage as int? ?? 1;
    var totalPages = ViewBag.TotalPages as int? ?? 1;
    var totalCount = ViewBag.TotalCount as int? ?? 0;
}

<div class="mb-4">
    <h2 class="mb-3">🛍️ Our Products</h2>
    
    <!-- Search and Filter -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="get" action="/Product" class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text">🔍</span>
                        <input type="text" name="search" class="form-control" 
                               placeholder="Search products..." value="@search" />
                    </div>
                </div>
                <div class="col-md-4">
                    <select name="categoryId" class="form-select" asp-items="categories">
                        <option value="">All Categories</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-success w-100">Filter</button>
                </div>
            </form>                  
        </div>
    </div>

    <!-- Results Info -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <p class="mb-0 text-muted">Showing @Model.Count of @totalCount products</p>
    </div>

    <!-- Products Grid -->
    @if (Model != null && Model.Any())
    {
        <div class="row">
            @foreach (var product in Model)
            {
                <div class="col-md-3 col-sm-6 mb-4">
                    <div class="card product-card h-100 shadow-sm">
                        <div class="position-relative">
                            @{
                                var imageSrc = !string.IsNullOrEmpty(product.ImageUrl) && (product.ImageUrl.StartsWith("http://") || product.ImageUrl.StartsWith("https://"))
                                    ? product.ImageUrl
                                    : "/images/products/" + (product.ImageUrl ?? "placeholder.jpg");
                            }
                            <img src="@imageSrc" 
                                 class="card-img-top" 
                                 alt="@product.Name"
                                 onerror="this.onerror=null; this.src='/images/products/placeholder.jpg';" />
                            @if (product.StockQuantity <= 10)
                            {
                                <span class="badge bg-danger position-absolute top-0 end-0 m-2">
                                    @(product.StockQuantity == 0 ? "Out of Stock" : "Low Stock")
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success position-absolute top-0 end-0 m-2">In Stock</span>
                            }
                        </div>
                        <div class="card-body d-flex flex-column">
                            <span class="badge bg-light text-dark mb-2 align-self-start">
                                @product.Category?.Name
                            </span>
                            <h6 class="card-title">@product.Name</h6>
                            <p class="card-text small text-muted flex-grow-1">
                                @(product.Description?.Length > 80 ? product.Description.Substring(0, 80) + "..." : product.Description)
                            </p>
                            <div class="mt-auto">
                                <div class="price mb-2">₱@product.Price.ToString("N2")</div>
                                <div class="d-flex gap-2">
                                    <a href="/Product/Details/@product.ProductId" 
                                       class="btn btn-outline-success btn-sm flex-grow-1">Details</a>
                                    @if (product.StockQuantity > 0)
                                    {
                                        <form method="post" action="/Product/AddToCart" class="flex-grow-1">
                                            <input type="hidden" name="productId" value="@product.ProductId" />
                                            <input type="hidden" name="quantity" value="1" />
                                            <button type="submit" class="btn btn-success btn-sm w-100">Add to Cart</button>
                                        </form>
                                    }
                                </div>
                                <small class="text-muted">Stock: @product.StockQuantity</small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Pagination -->
        @if (totalPages > 1)
        {
            <nav aria-label="Page navigation">
                <ul class="pagination justify-content-center">
                    <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                        <a class="page-link" href="/Product?page=@(currentPage - 1)&search=@search&categoryId=@categoryId">Previous</a>
                    </li>
                    @for (int i = 1; i <= totalPages; i++)
                    {
                        <li class="page-item @(i == currentPage ? "active" : "")">
                            <a class="page-link" href="/Product?page=@i&search=@search&categoryId=@categoryId">@i</a>
                        </li>
                    }
                    <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                        <a class="page-link" href="/Product?page=@(currentPage + 1)&search=@search&categoryId=@categoryId">Next</a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <div class="text-center py-5">
            <h3>No products found</h3>
            <p>Try adjusting your search or filter criteria.</p>
        </div>
    }
</div>